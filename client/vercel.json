{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/product/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": ".*(facebookexternalhit|Twitterbot|Slackbot|LinkedInBot|WhatsApp|Discordbot|TelegramBot|Pinterestbot|Googlebot).*" } }],
      "destination": "/api/preview?type=product&id=:id"
    },
    {
      "source": "/blog/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": ".*(facebookexternalhit|Twitterbot|Slackbot|LinkedInBot|WhatsApp|Discordbot|TelegramBot|Pinterestbot|Googlebot).*" } }],
      "destination": "/api/preview?type=blog&id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "moris-clothings.vercel.app"
        }
      ],
      "destination": "https://morisclothing.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.morisclothing.co.uk"
        }
      ],
      "destination": "https://morisclothing.co.uk/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
